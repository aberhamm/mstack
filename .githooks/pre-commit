#!/usr/bin/env bash
# mstack pre-commit enforcement hook (plan 038). Thin shim: it locates the
# installed mstack-run skill and delegates the real logic to
# `review-gate.sh hook-pre-commit`, so the heavy diffing lives in one
# linted place and travels with the install across Skillshare/Codex/
# Claude. Shipped source: skills/mstack-run/hooks/pre-commit; installed into a
# repo's tracked .githooks/ by mstack-init / setup.
set -uo pipefail

# Resolve review-gate.sh across supported agent runtimes.
_find_review_gate() {
  local d
  for d in \
    "${HOME}/.config/skillshare/skills/mstack-run" \
    "${HOME}/.agents/skills/mstack-run" \
    "${HOME}/.codex/skills/mstack-run" \
    "${HOME}/.claude/skills/mstack-run"; do
    if [ -f "$d/scripts/review-gate.sh" ]; then
      printf '%s\n' "$d/scripts/review-gate.sh"
      return 0
    fi
  done
  return 1
}

# --- Repo self-test gate (mstack SOURCE repo only) -------------------------
# Runs mstack's own smoke suites at write time. This is a DEV guard, not part
# of the shipped enforcement product: it fires only in a checkout that actually
# contains the suites, so a consumer repo — which gets this hook but has no
# skills/mstack-run/scripts/ — skips it for the price of one directory test.
#
# Why it exists: three separate defects shipped from this repo in a single day
# that a suite run would have caught — review-gate.sh committed 100644 (so the
# discriminator never ran at all), an append-only false-silence hole, and a
# macOS mktemp bug that killed the cross-model audit. Suites that run only when
# someone remembers to run them are the same "gate that silently never fires"
# class this repo keeps having to fix.
#
# Cost control: fires only when the STAGED set touches an executable surface,
# which is about a third of commits here; a prose, doc, or plan-only commit
# pays nothing. Bypass with MSTACK_SKIP_SMOKE=1, or git commit --no-verify.
#
# Honest limitation, stated rather than papered over: the suites exercise the
# WORKING TREE, not the staged content. On a partially-staged commit they can
# pass while the committed subset would not. Solo-on-main makes that rare; it
# is a deterrent, not a proof — the same honest residual as the rest of the
# plan-038 model.
_mstack_repo_smoke() {
  [ -z "${MSTACK_SKIP_SMOKE:-}" ] || return 0
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  [ -d "$root/skills/mstack-run/scripts" ] || return 0

  git diff --cached --name-only --diff-filter=ACMR 2>/dev/null \
    | grep -qE '^(skills/.*\.sh$|skills/mstack-run/hooks/|bin/|setup$)' || return 0

  local s log failed=0
  # NOTE: the mktemp template MUST end in X's — BSD/macOS rejects a suffix and
  # fails with a misleading "File exists". That exact bug killed plan-doctor's
  # codex audit; do not reintroduce it here.
  log="$(mktemp "${TMPDIR:-/tmp}/mstack-smoke-XXXXXX")" || return 0
  for s in script-mode-smoke review-gate-smoke verify-lint-smoke health-reach-smoke health-score-smoke wrapup-scan-smoke plan-ref-smoke hook-chain-smoke pick-next-smoke premise-lint-smoke rule-toggle-smoke fixture-lint-smoke brief-content-smoke; do
    [ -f "$root/skills/mstack-run/scripts/$s.sh" ] || continue
    if ! bash "$root/skills/mstack-run/scripts/$s.sh" >"$log" 2>&1; then
      echo "mstack pre-commit: $s.sh FAILED" >&2
      tail -15 "$log" >&2
      failed=1
    fi
  done
  rm -f "$log"
  if [ "$failed" -ne 0 ]; then
    echo "" >&2
    echo "Commit refused: mstack smoke suite failed. Fix it, or bypass with" >&2
    echo "MSTACK_SKIP_SMOKE=1 git commit ... (or --no-verify)." >&2
    return 1
  fi
  return 0
}
_mstack_repo_smoke || exit 1

RG="$(_find_review_gate || true)"
if [ -n "$RG" ]; then
  # Forward "$@" so review-gate.sh can chain to any pre-existing pre-commit hook
  # that core.hooksPath shadows (git passes pre-commit no args today, but keep
  # the two shims symmetric and future-proof).
  exec bash "$RG" hook-pre-commit "$@"
fi

# Fallback: review-gate.sh is not reachable. Do NOT brick ordinary commits, but
# do NOT let a plan completion slip through unverified either. Cheaply detect a
# staged plan done-transition (git show :path — staged, not the working tree)
# and fail closed only on that guarded transition. A weakening-only edit cannot
# be evaluated without the gate script and passes here; the missing install is
# itself caught by mstack-run / mstack-plan-doctor's startup assert-hook-installed
# and by `review-gate.sh audit`, so this residual is detectable.
_fm_status_stdin() {
  awk '
    /^---[[:space:]]*$/ { fm++; next }
    fm==1 && /^status:/ { sub(/^status:[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }
    fm==2 { exit }
  '
}

found_transition=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in
    docs/plans/*.md|plans/*.md) ;;
    *) continue ;;
  esac
  staged_status="$(git show ":$path" 2>/dev/null | _fm_status_stdin)"
  head_status="$(git show "HEAD:$path" 2>/dev/null | _fm_status_stdin)"
  if [ "$staged_status" = "done" ] && [ "$head_status" != "done" ]; then
    found_transition=1
    break
  fi
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)
EOF

if [ "$found_transition" -eq 1 ]; then
  echo "mstack pre-commit: this commit marks a plan done but review-gate.sh could not be found." >&2
  echo "Refusing to allow a plan completion without the enforcement gate. Install mstack" >&2
  echo "(run mstack-init, or ./setup from the mstack source repo) so the hook can verify review records." >&2
  exit 1
fi

# Even in this degraded path (review-gate.sh unreachable), stay a good
# core.hooksPath citizen: chain to any pre-existing pre-commit hook that
# .githooks shadows (e.g. the operator's gitleaks secret scanner). Resolution
# mirrors review-gate.sh's _chain_prior_hook; mstack-init captured the prior
# path into mstack.priorHooksPath.
_chain_prior_precommit() {
  local root prior abs cur git_dir hook
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  prior="$(git config --get mstack.priorHooksPath 2>/dev/null || true)"
  if [ -n "$prior" ]; then
    case "$prior" in /*) abs="$prior" ;; *) abs="$root/$prior" ;; esac
  else
    git_dir="$(git rev-parse --git-dir 2>/dev/null)" || return 0
    case "$git_dir" in /*) abs="$git_dir/hooks" ;; *) abs="$root/$git_dir/hooks" ;; esac
  fi
  cur="$(git config --get core.hooksPath 2>/dev/null || true)"
  if [ -n "$cur" ]; then
    case "$cur" in /*) : ;; *) cur="$root/$cur" ;; esac
    [ "$abs" != "$cur" ] || return 0
  fi
  hook="$abs/pre-commit"
  [ -x "$hook" ] || return 0
  "$hook" "$@"
}
_chain_prior_precommit "$@"
exit $?
