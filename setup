#!/usr/bin/env bash
# setup — link mstack skills into the parent skill directory
# After cloning, run ./setup to make all skills discoverable by the host agent.
# Re-run after adding new skills or pulling updates.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$REPO_DIR")"

linked=0
for skill_dir in "$REPO_DIR"/skills/mstack-*; do
  [ -d "$skill_dir" ] || continue
  name=$(basename "$skill_dir")
  target="$PARENT_DIR/$name"

  if [ -L "$target" ]; then
    existing=$(readlink "$target")
    if [ "$existing" = "$skill_dir" ]; then
      continue
    fi
    rm -f "$target"
  elif [ -d "$target" ]; then
    echo "warning: $target exists as a real directory, skipping (remove it manually to link)"
    continue
  fi

  ln -sf "$skill_dir" "$target"
  linked=$((linked + 1))
  echo "  linked: $name"
done

total=$(find "$REPO_DIR/skills" -maxdepth 1 -type d -name 'mstack-*' | wc -l | tr -d ' ')
echo ""
echo "mstack: $total skills ($linked newly linked)"

if command -v skillshare >/dev/null 2>&1; then
  echo ""
  echo "Detected skillshare — running sync to propagate to other targets..."
  skillshare sync 2>/dev/null || true
fi

# Install mstack enforcement git hooks (plan 038): point this repo's git at the
# tracked .githooks/ dir so the pre-commit / pre-push barriers are active. This
# is the only way the hooks exist in a fresh clone (git's default .git/hooks is
# not cloned). Idempotent: hooks are refreshed and core.hooksPath is only
# rewritten when it is not already the tracked path.
HOOKS_SRC="$REPO_DIR/skills/mstack-run/hooks"
if [ -d "$HOOKS_SRC" ] && git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  mkdir -p "$REPO_DIR/.githooks"
  for h in pre-commit pre-push; do
    if [ -f "$HOOKS_SRC/$h" ]; then
      cp "$HOOKS_SRC/$h" "$REPO_DIR/.githooks/$h"
      chmod +x "$REPO_DIR/.githooks/$h"
    fi
  done
  # Capture the hooksPath active BEFORE mstack takes over so the enforcement
  # hooks can chain to a pre-existing global hook (e.g. gitleaks) rather than
  # shadow it. See scripts/init.sh for the precedence rationale. Never store
  # .githooks (would recurse); re-runnable via the global/system fallback.
  prior_local="$(git -C "$REPO_DIR" config --local --get core.hooksPath 2>/dev/null || true)"
  if [ -n "$prior_local" ] && [ "$prior_local" != ".githooks" ]; then
    prior="$prior_local"
  else
    prior="$(git -C "$REPO_DIR" config --global --get core.hooksPath 2>/dev/null || true)"
    [ -n "$prior" ] || prior="$(git -C "$REPO_DIR" config --system --get core.hooksPath 2>/dev/null || true)"
  fi
  if [ -n "$prior" ] && [ "$prior" != ".githooks" ]; then
    git -C "$REPO_DIR" config mstack.priorHooksPath "$prior"
    echo "  captured prior hooksPath for chaining: mstack.priorHooksPath=$prior"
  fi
  if [ "$(git -C "$REPO_DIR" config --get core.hooksPath 2>/dev/null || true)" != ".githooks" ]; then
    git -C "$REPO_DIR" config core.hooksPath .githooks
    echo ""
    echo "  installed mstack enforcement hooks (core.hooksPath=.githooks)"
  fi
fi

# Check for gstack
has_gstack=false
if [ -d "$PARENT_DIR/browse" ] || [ -d "$PARENT_DIR/qa" ] || command -v gstack >/dev/null 2>&1; then
  has_gstack=true
fi

echo ""
if [ "$has_gstack" = true ]; then
  echo "gstack detected — plan reviews, cross-model code review, and browser QA are available."
else
  echo "Note: gstack is not installed. mstack works without it, but gstack adds"
  echo "interactive plan reviews, cross-model code review, and browser-based QA."
  echo "Install: npx gstack-cli@latest install"
  echo "More info: https://github.com/AiCodeCraft/gstack"
fi
