#!/usr/bin/env bash
# setup — link mstack skills into the parent skill directory
# After cloning, run ./setup to make all skills discoverable by the host agent.
# Re-run after adding new skills or pulling updates.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$REPO_DIR")"

linked=0
for skill_dir in "$REPO_DIR"/skills/mstack-*; do
  [ -d "$skill_dir" ] || continue
  name=$(basename "$skill_dir")
  target="$PARENT_DIR/$name"

  if [ -L "$target" ]; then
    existing=$(readlink "$target")
    if [ "$existing" = "$skill_dir" ]; then
      continue
    fi
    rm -f "$target"
  elif [ -d "$target" ]; then
    echo "warning: $target exists as a real directory, skipping (remove it manually to link)"
    continue
  fi

  ln -sf "$skill_dir" "$target"
  linked=$((linked + 1))
  echo "  linked: $name"
done

total=$(find "$REPO_DIR/skills" -maxdepth 1 -type d -name 'mstack-*' | wc -l | tr -d ' ')
echo ""
echo "mstack: $total skills ($linked newly linked)"

if command -v skillshare >/dev/null 2>&1; then
  echo ""
  echo "Detected skillshare — running sync to propagate to other targets..."
  skillshare sync 2>/dev/null || true
fi

# Check for gstack
has_gstack=false
if [ -d "$PARENT_DIR/browse" ] || [ -d "$PARENT_DIR/qa" ] || command -v gstack >/dev/null 2>&1; then
  has_gstack=true
fi

echo ""
if [ "$has_gstack" = true ]; then
  echo "gstack detected — plan reviews, cross-model code review, and browser QA are available."
else
  echo "Note: gstack is not installed. mstack works without it, but gstack adds"
  echo "interactive plan reviews, cross-model code review, and browser-based QA."
  echo "Install: npx gstack-cli@latest install"
  echo "More info: https://github.com/AiCodeCraft/gstack"
fi
