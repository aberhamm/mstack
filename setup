#!/usr/bin/env bash
# setup — link mstack skills into a safe skill directory
# After cloning, run ./setup to make all skills discoverable by the host agent.
# Re-run after adding new skills or pulling updates.
set -euo pipefail

usage() {
  cat <<'EOF'
mstack setup — link MStack skills and optional integrations

Usage: ./setup [options]

Options:
  --without-gstack Skip the optional GStack MStack profile install.
  --with-gstack    Explicitly install the profile (the default; retained for
                    scripts written before it became the default).
  -h, --help       Show this help and exit.

Environment:
  MSTACK_GSTACK_DIR  Explicit path to a GStack checkout when auto-discovery
                     cannot find one.
  MSTACK_LINK_MODE   `symlink` (default) or `copy`. On Windows, `copy` is
                     selected automatically because symlink creation often
                     requires elevated privileges or Developer Mode.
EOF
}

INSTALL_GSTACK_PROFILE=1
while [ $# -gt 0 ]; do
  case "$1" in
    --with-gstack) INSTALL_GSTACK_PROFILE=1; shift ;;
    --without-gstack) INSTALL_GSTACK_PROFILE=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "mstack: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$REPO_DIR")"

# MStack's runtime is Bash plus standard Unix command-line tools. Git Bash and
# WSL provide that environment on Windows, but native PowerShell and cmd.exe do
# not. Git Bash can create symlinks only when Windows permissions allow it, so
# use managed directory copies there instead. Re-running setup refreshes only
# copies marked as MStack-managed; an unrelated real directory is left intact.
WINDOWS_SHELL=0
case "$(uname -s 2>/dev/null || true)" in
  MINGW*|MSYS*|CYGWIN*) WINDOWS_SHELL=1 ;;
esac

LINK_MODE="${MSTACK_LINK_MODE:-}"
if [ -z "$LINK_MODE" ]; then
  if [ "$WINDOWS_SHELL" -eq 1 ]; then
    LINK_MODE=copy
    echo "mstack: Windows shell detected; installing managed skill copies (not symlinks)."
  else
    LINK_MODE=symlink
  fi
fi
case "$LINK_MODE" in
  symlink|copy) ;;
  *) echo "mstack: MSTACK_LINK_MODE must be 'symlink' or 'copy', got: $LINK_MODE" >&2; exit 2 ;;
esac

is_skill_dir() {
  local candidate="$1"
  [ "$candidate" = "$HOME/.config/skillshare/skills" ] || \
    [ "$candidate" = "$HOME/.agents/skills" ] || \
    [ "$candidate" = "$HOME/.codex/skills" ] || \
    [ "$candidate" = "$HOME/.claude/skills" ]
}

LINK_DIR="${MSTACK_SKILL_DIR:-}"
if [ -n "$LINK_DIR" ]; then
  [ -d "$LINK_DIR" ] || {
    echo "mstack: MSTACK_SKILL_DIR is not a directory: $LINK_DIR" >&2
    exit 2
  }
elif is_skill_dir "$PARENT_DIR"; then
  LINK_DIR="$PARENT_DIR"
elif [ -d "$HOME/.config/skillshare/skills" ]; then
  LINK_DIR="$HOME/.config/skillshare/skills"
  echo "mstack: source checkout detected; linking into Skillshare source: $LINK_DIR"
else
  LINK_DIR=""
  echo "mstack: source checkout detected outside a skills directory; no links created."
  echo "mstack: set MSTACK_SKILL_DIR to install deliberately."
fi

linked=0
if [ -n "$LINK_DIR" ]; then
  for skill_dir in "$REPO_DIR"/skills/mstack-*; do
    [ -d "$skill_dir" ] || continue
    name=$(basename "$skill_dir")
    target="$LINK_DIR/$name"

    if [ -d "$target" ] && [ ! -L "$target" ] && [ -f "$target/.mstack-managed-copy" ]; then
      rm -rf "$target"
    elif [ -L "$target" ]; then
      existing=$(readlink "$target")
      if [ "$LINK_MODE" = symlink ] && [ "$existing" = "$skill_dir" ]; then
        continue
      fi
      rm -f "$target"
    elif [ -d "$target" ]; then
      echo "warning: $target exists as a real directory, skipping (remove it manually to install here)"
      continue
    fi

    if [ "$LINK_MODE" = copy ]; then
      cp -R "$skill_dir" "$target"
      : > "$target/.mstack-managed-copy"
    else
      ln -sf "$skill_dir" "$target"
    fi
    linked=$((linked + 1))
    echo "  installed: $name ($LINK_MODE)"
  done
fi

total=$(find "$REPO_DIR/skills" -maxdepth 1 -type d -name 'mstack-*' | wc -l | tr -d ' ')
echo ""
echo "mstack: $total skills ($linked newly linked)"

if command -v skillshare >/dev/null 2>&1 && [ "${MSTACK_SKIP_SKILLSHARE_SYNC:-0}" != "1" ]; then
  echo ""
  echo "Detected skillshare — running sync to propagate to other targets..."
  skillshare sync 2>/dev/null || true
fi

if [ "$INSTALL_GSTACK_PROFILE" -eq 1 ]; then
  GSTACK_DIR="${MSTACK_GSTACK_DIR:-}"
  if [ -z "$GSTACK_DIR" ]; then
    for candidate in \
      "$HOME/.config/skillshare/skills/gstack" \
      "$HOME/.gstack/repos/gstack" \
      "$HOME/.claude/skills/gstack"; do
      if [ -x "$candidate/setup" ]; then
        GSTACK_DIR="$candidate"
        break
      fi
    done
  fi

  if [ -z "$GSTACK_DIR" ] || [ ! -x "$GSTACK_DIR/setup" ]; then
    echo "mstack: GStack checkout not found; skipping the optional MStack profile."
    echo "  Install GStack and re-run ./setup, or set MSTACK_GSTACK_DIR."
  else
    echo ""
    echo "Installing GStack's MStack profile..."
    "$GSTACK_DIR/setup" --host auto --profile mstack --quiet
  fi
fi

# Install mstack enforcement git hooks (plan 038): point this repo's git at the
# tracked .githooks/ dir so the pre-commit / pre-push barriers are active. This
# is the only way the hooks exist in a fresh clone (git's default .git/hooks is
# not cloned). Idempotent: hooks are refreshed and core.hooksPath is only
# rewritten when it is not already the tracked path.
HOOKS_SRC="$REPO_DIR/skills/mstack-run/hooks"
if [ -d "$HOOKS_SRC" ] && git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  mkdir -p "$REPO_DIR/.githooks"
  for h in pre-commit pre-push; do
    if [ -f "$HOOKS_SRC/$h" ]; then
      cp "$HOOKS_SRC/$h" "$REPO_DIR/.githooks/$h"
      chmod +x "$REPO_DIR/.githooks/$h"
    fi
  done
  # Capture the hooksPath active BEFORE mstack takes over so the enforcement
  # hooks can chain to a pre-existing global hook (e.g. gitleaks) rather than
  # shadow it. See scripts/init.sh for the precedence rationale. Never store
  # .githooks (would recurse); re-runnable via the global/system fallback.
  prior_local="$(git -C "$REPO_DIR" config --local --get core.hooksPath 2>/dev/null || true)"
  if [ -n "$prior_local" ] && [ "$prior_local" != ".githooks" ]; then
    prior="$prior_local"
  else
    prior="$(git -C "$REPO_DIR" config --global --get core.hooksPath 2>/dev/null || true)"
    [ -n "$prior" ] || prior="$(git -C "$REPO_DIR" config --system --get core.hooksPath 2>/dev/null || true)"
  fi
  if [ -n "$prior" ] && [ "$prior" != ".githooks" ]; then
    git -C "$REPO_DIR" config mstack.priorHooksPath "$prior"
    echo "  captured prior hooksPath for chaining: mstack.priorHooksPath=$prior"
  fi
  if [ "$(git -C "$REPO_DIR" config --get core.hooksPath 2>/dev/null || true)" != ".githooks" ]; then
    git -C "$REPO_DIR" config core.hooksPath .githooks
    echo ""
    echo "  installed mstack enforcement hooks (core.hooksPath=.githooks)"
  fi
fi

# Check for gstack
has_gstack=false
if [ -d "$PARENT_DIR/browse" ] || [ -d "$PARENT_DIR/qa" ] || command -v gstack >/dev/null 2>&1; then
  has_gstack=true
fi

echo ""
if [ "$has_gstack" = true ]; then
  echo "gstack detected — plan reviews, cross-model code review, and browser QA are available."
else
  echo "Note: gstack is not installed. mstack works without it, but gstack adds"
  echo "interactive plan reviews, cross-model code review, and browser-based QA."
  echo "Install GStack, then re-run ./setup to add its MStack profile."
  echo "More info: https://github.com/AiCodeCraft/gstack"
fi
