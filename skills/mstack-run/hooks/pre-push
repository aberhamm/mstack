#!/usr/bin/env bash
# mstack pre-push enforcement hook (plan 038). Thin shim: locates the installed
# mstack-run skill and delegates to `review-gate.sh hook-pre-push`, which reads
# the git pre-push ref lines from stdin and rejects a push that publishes a
# mstack/plan-*-done completion tag for a plan that is not completable.
# Shipped source: skills/mstack-run/hooks/pre-push; installed into a repo's
# tracked .githooks/ by mstack-init / setup.
#
# git invokes this hook as: pre-push <remote-name> <remote-url>, with one ref
# line per pushed ref on stdin:
#   <local ref> SP <local sha> SP <remote ref> SP <remote sha> LF
set -uo pipefail

_find_review_gate() {
  local d
  for d in \
    "${HOME}/.config/skillshare/skills/mstack-run" \
    "${HOME}/.agents/skills/mstack-run" \
    "${HOME}/.codex/skills/mstack-run" \
    "${HOME}/.claude/skills/mstack-run"; do
    if [ -f "$d/scripts/review-gate.sh" ]; then
      printf '%s\n' "$d/scripts/review-gate.sh"
      return 0
    fi
  done
  return 1
}

RG="$(_find_review_gate || true)"
if [ -n "$RG" ]; then
  # exec preserves stdin (the ref lines) for review-gate.sh to read. Forward
  # "$@" (<remote-name> <remote-url>) so it can chain to a pre-existing pre-push
  # hook (e.g. a git-lfs pass-through) that core.hooksPath shadows.
  exec bash "$RG" hook-pre-push "$@"
fi

# Fallback: review-gate.sh not reachable. Buffer stdin so we can both scan the
# ref lines and replay them to a chained prior pre-push hook. Fail closed on a
# completion tag being created; pass everything else so ordinary branch pushes
# are never bricked by a missing install.
tmp_refs="$(mktemp "${TMPDIR:-/tmp}/mstack-prepush-XXXXXX")"
trap 'rm -f "$tmp_refs"' EXIT
cat > "$tmp_refs"

found_tag=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in
    refs/tags/mstack/plan-*-done) ;;
    *) continue ;;
  esac
  case "${local_sha:-}" in
    *[!0]*) found_tag=1; break ;;
    *) continue ;;
  esac
done < "$tmp_refs"

if [ "$found_tag" -eq 1 ]; then
  echo "mstack pre-push: a mstack/plan-*-done completion tag is being pushed but review-gate.sh" >&2
  echo "could not be found to verify it. Refusing. Install mstack (run mstack-init, or ./setup" >&2
  echo "from the mstack source repo) so the hook can verify the plan is completable." >&2
  exit 1
fi

# Degraded-path citizen: chain to any pre-existing pre-push hook that .githooks
# shadows, replaying the ref lines on stdin. Resolution mirrors
# review-gate.sh's _chain_prior_hook.
_chain_prior_prepush() {
  local root prior abs cur git_dir hook
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  prior="$(git config --get mstack.priorHooksPath 2>/dev/null || true)"
  if [ -n "$prior" ]; then
    case "$prior" in /*) abs="$prior" ;; *) abs="$root/$prior" ;; esac
  else
    git_dir="$(git rev-parse --git-dir 2>/dev/null)" || return 0
    case "$git_dir" in /*) abs="$git_dir/hooks" ;; *) abs="$root/$git_dir/hooks" ;; esac
  fi
  cur="$(git config --get core.hooksPath 2>/dev/null || true)"
  if [ -n "$cur" ]; then
    case "$cur" in /*) : ;; *) cur="$root/$cur" ;; esac
    [ "$abs" != "$cur" ] || return 0
  fi
  hook="$abs/pre-push"
  [ -x "$hook" ] || return 0
  grep -q '_find_review_gate' "$hook" 2>/dev/null && return 0
  "$hook" "$@"
}
_chain_prior_prepush "$@" < "$tmp_refs"
exit $?
